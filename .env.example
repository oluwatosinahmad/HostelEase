# ==============================================================================
# HOSTEL EASE (LAUTECH EDITION) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' on your production server and configure the real values.
# NEVER commit the actual '.env' file containing secrets to GitHub!

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on your live server; 'development' on local machine
NODE_ENV=production

# The port where the unified Node.js/Express server listens (e.g. 5000)
PORT=5000

# The public canonical URL of your deployed application (used in emails & links)
APP_URL=https://hostelease.ng

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate a secure 64-character random string for signing JWT authentication tokens.
# Example command to generate: openssl rand -base64 48
AUTH_JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production_min_32_chars

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Path to the SQLite persistent database file.
# Default is './data/hostel_ease.db'. Ensure the directory has read/write permissions.
DATABASE_PATH=./data/hostel_ease.db

# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN ACCESS
# ------------------------------------------------------------------------------
# Allowed origins for CORS requests. Comma-separated if multiple domains are used.
# Leave blank or set to '*' for all, or restrict to your production domain(s):
CORS_ORIGIN=https://hostelease.ng,https://www.hostelease.ng

# ------------------------------------------------------------------------------
# 5. INITIAL PLATFORM ADMINISTRATOR (OPTIONAL INITIAL SETUP)
# ------------------------------------------------------------------------------
# These credentials can be used during initial deployment provisioning.
ADMIN_INITIAL_EMAIL=admin@hostelease.ng
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword2026!

# ------------------------------------------------------------------------------
# 6. PAYSTACK TEST MODE CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain your test keys from Paystack Dashboard > Settings > API Keys & Webhooks:
# https://dashboard.paystack.com/#/settings/developer
# NEVER put live secret keys here. Use TEST keys only (sk_test_... and pk_test_...).
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_placeholder
VITE_PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYMENT_PROVIDER=PAYSTACK
